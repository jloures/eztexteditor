{
  "name": "eztexteditor",
  "version": "2.0.0",
  "description": "A secure, client-side, multi-tab Markdown editor with WASM-accelerated core. Stores 100% of your data in the URL.",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "build:wasm": "cd wasm-core && cargo build --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir pkg target/wasm32-unknown-unknown/release/eztexteditor_wasm.wasm",
    "dev": "npm run build:wasm && vite",
    "build": "vite build",
    "build:single": "npm run build:wasm && SINGLE_FILE=1 vite build",
    "preview": "vite preview",
    "build:extension": "BUILD_TARGET=extension vite build",
    "test": "jest --config jest.config.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jloures/eztexteditor.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jloures/eztexteditor/issues"
  },
  "homepage": "https://github.com/jloures/eztexteditor#readme",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "canvas": "^3.2.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.4.0",
    "vite": "^6.4.1",
    "vite-plugin-singlefile": "^2.3.2",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.27",
    "d3": "^7.9.0",
    "driver.js": "^1.4.0",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.44",
    "mermaid": "^11.13.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19"
  }
}
